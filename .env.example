# Local backend configuration template; copy to .env and replace placeholders.
# 1. Set the actual API base URL and exact model ID; neither has a built-in default.
# 2. Set reasoning effort and a local secret; optional runtime settings follow.
# Never commit .env; this template contains no working deployment credentials.
CODEATELIER_BASE_URL=https://api.example.com/v1
CODEATELIER_MODEL=YOUR_MODEL_ID
CODEATELIER_REASONING_EFFORT=high
# Set the key locally; never commit .env.
CODEATELIER_API_KEY=
# CODEATELIER_DATA_DIR=
# CODEATELIER_PORT=4142
# CODEATELIER_LOG_LEVEL=info
