# Local backend configuration template; copy to .env and replace placeholders.
# API address and model IDs are the single source of connection configuration.
# The Web UI displays them read-only; edit this file, then restart or reload the service to change them.
# settings.json stores only non-connection preferences such as reasoning effort and runtime limits.
# Never commit .env; this template contains no working deployment credentials.
CODEATELIER_BASE_URL=https://api.example.com/v1
CODEATELIER_MODEL=YOUR_MODEL_ID
CODEATELIER_REASONING_EFFORT=high
# Set the key locally; never commit .env.
CODEATELIER_API_KEY=
# CODEATELIER_DATA_DIR=
# Optional MCP config absolute path; default is mcp.json in the backend data directory.
# See docs/mcp.md. Connections and credentials stay in the local backend; restart after edits.
# CODEATELIER_MCP_CONFIG=
# CODEATELIER_PORT=4142
# Default: 127.0.0.1. Use ::1 for IPv6 loopback, or 0.0.0.0 / :: for trusted LAN access.
# LAN mode should use the optional password gate and always block public inbound access with your firewall.
# CODEATELIER_LISTEN_ADDRESS=127.0.0.1
# Optional Web UI password gate. Leave the switch empty for its disabled default; set true with a non-empty local password to enable it.
CODEATELIER_WEB_PASSWORD_ENABLED=
CODEATELIER_WEB_PASSWORD=
# CODEATELIER_LOG_LEVEL=info

# Optional system sandbox. Leave empty or set false to retain V1 host command execution.
# Windows needs explicit native installation; Linux/macOS use MXC and the built POSIX bundle.
# POSIX startup failures stop the task without host fallback. macOS is not yet device-validated.
# See docs/posix-sandbox.md and docs/windows-sandbox-guide.md.
CODEATELIER_SANDBOX_ENABLED=false
# Optional POSIX-only existing absolute roots as JSON arrays; never grant all HOME or /.
# CODEATELIER_SANDBOX_READ_ROOTS=[]
# CODEATELIER_SANDBOX_WRITE_ROOTS=[]

# Optional auxiliary model on the same endpoint; empty inherits the main model for title and summary.
# Its reasoning effort is an environment default until the Web UI saves a preference.
CODEATELIER_AUXILIARY_MODEL=
CODEATELIER_AUXILIARY_REASONING_EFFORT=low
